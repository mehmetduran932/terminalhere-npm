{
  "name": "@mehmetduran/terminalhere",
  "version": "0.1.0",
  "description": "Manage Windows Explorer terminal context-menu entries from npm.",
  "type": "module",
  "bin": {
    "terminalhere": "./dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "exports": "./dist/index.js",
